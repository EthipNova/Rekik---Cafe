# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side API configuration. The supplied publishable key may be used here
# only when the database RLS policies permit the required server operations.
SUPABASE_URL=
SUPABASE_KEY=

# Optional server-only key. Never prefix this value with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
