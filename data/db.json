  "about_content": {
    "id": 1,
    "homepage_hero_image": "/images/rekik-hero.jpg",
    "about_hero_image": "/images/rekik-story.jpg",
    "about_title": "Ethiopia's Finest Harvest, Artfully Roasted",
    "about_description": "At Rekik Coffee, we honour generations of Ethiopian coffee heritage. From the misty highlands of Yirgacheffe, Sidama, and Guji to your cup, we roast specialty-grade single-origin beans with passion, authenticity, and warm Ethiopian hospitality.",
    "story_title": "Rooted in Tradition. Crafted for the Modern Palate.",
    "story_content": "Rekik Coffee was founded on a deep reverence for the birthplace of coffee. In Ethiopia, coffee is not just a morning ritual—it is community, conversation, and a celebration of life through the timeless Buna ceremony.\n\nWe unite this rich heritage with precision artisanal roasting. Every batch is hand-selected and crafted to bring out complex floral aromas, bright citrus notes, and silky chocolate finishes.",
    "story_image": "/images/rekik-story.jpg",
    "value_1_title": "Single-Origin Purity",
    "value_1_description": "Ethically sourced from high-altitude Ethiopian farms renowned for unparalleled cup quality.",
    "value_2_title": "Artisanal Roasting",
    "value_2_description": "Small-batch roasted to unlock the vibrant floral, fruity, and sweet nuances of authentic heirloom beans.",
    "value_3_title": "Warm Buna Hospitality",
    "value_3_description": "Experience genuine Ethiopian warmth, whether you are enjoying a slow pour-over in our café or ordering ahead online.",
    "updated_at": "2026-10-18T00:00:00.000Z"
  }
